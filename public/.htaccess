RewriteEngine On

# Use one canonical HTTPS origin while preserving paths and query strings.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^coderware\.co\.uk$ [NC]
RewriteRule ^ https://coderware.co.uk%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # The site is entirely self-contained. Inline scripts are permitted only
    # because the page contains inline JSON-LD structured data.
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"

    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
</IfModule>

ServerSignature Off
