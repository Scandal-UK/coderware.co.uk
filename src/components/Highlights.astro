---
const { highlights } = Astro.props;
---

<section aria-labelledby="career-highlights-heading">
  <h2 id="career-highlights-heading">Career highlights</h2>

  <dl>
    {
      highlights.map((highlight) => (
        <div>
          <dt>{highlight.category}</dt>
          <dd>{highlight.text}</dd>
        </div>
      ))
    }
  </dl>
</section>
