---
import { render } from 'astro:content';

const { profile, email } = Astro.props;
const { Content } = await render(profile);
---

<header class="profile-header">
  <div class="profile-identity">
    <h1>{profile.data.name}</h1>
    <p class="profile-role">{profile.data.role}</p>

    {
      profile.data.secondaryRole && (
        <p class="profile-secondary-role">{profile.data.secondaryRole}</p>
      )
    }

    <p class="profile-location">{profile.data.location}</p>
  </div>

  <nav aria-label="Professional profiles">
    <ul>
      <li><a href={`mailto:${email}`}>Email</a></li>
      <li><a href={profile.data.linkedin} rel="me">LinkedIn</a></li>
      <li><a href={profile.data.github} rel="me">GitHub</a></li>
      <li><a href="/dan-ware-cv.pdf" download>Download CV</a></li>
    </ul>
  </nav>
</header>

<section class="professional-profile" aria-labelledby="professional-profile-heading">
  <h2 id="professional-profile-heading">Professional profile</h2>
  <Content />
</section>

{
  profile.data.specialisms.length > 0 && (
    <section class="specialisms" aria-labelledby="specialisms-heading">
      <h2 id="specialisms-heading">Specialisms</h2>
      <ul>
        {profile.data.specialisms.map((specialism) => (
          <li>{specialism}</li>
        ))}
      </ul>
    </section>
  )
}
