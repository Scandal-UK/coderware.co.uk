---
const { skills } = Astro.props;

const categories = [
  {
    heading: 'Software development',
    skills: skills.softwareDevelopment,
  },
  {
    heading: 'Cloud & DevOps',
    skills: skills.cloudDevOps,
  },
  {
    heading: 'Identity & Access Management (IAM)',
    skills: skills.identitySecurity,
  },
  {
    heading: 'Front end',
    skills: skills.frontEnd,
  },
  {
    heading: 'Engineering practices',
    skills: skills.engineering,
  },
  {
    heading: 'AI-assisted development',
    skills: skills.aiAssisted,
  },
];
---

<section class="technical-expertise" aria-labelledby="technical-expertise-heading">
  <h2 id="technical-expertise-heading">Technical expertise</h2>

  <div class="skills-grid">
    {
      categories.map((category) => (
        <section>
          <h3>{category.heading}</h3>
          <ul>
            {category.skills.map((skill) => <li>{skill}</li>)}
          </ul>
        </section>
      ))
    }
  </div>
</section>
