---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, structuredData } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL('/social-preview.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" property="og:description" content={description} />
    <meta name="author" content="Dan Ware" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" name="title" content={title} />
    <meta property="og:url" name="url" content={canonicalUrl} />

    <meta property="og:image" name="image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta
      property="og:image:alt"
      content="Dan Ware — Senior Software Engineer"
    />

    <meta property="og:site_name" content="Dan Ware" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
