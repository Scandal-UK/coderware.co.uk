---
import { getCollection, getEntry } from 'astro:content';
import Experience from '../components/Experience.astro';
import Highlights from '../components/Highlights.astro';
import Profile from '../components/Profile.astro';
import Skills from '../components/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Dan Ware | Senior Software Engineer';

const profile = await getEntry('profile', 'profile');

if (!profile) {
  throw new Error('Profile content is missing');
}

const highlights = await getEntry('highlights', 'highlights');

if (!highlights) {
  throw new Error('Career highlights content is missing');
}

const skills = await getEntry('skills', 'skills');

if (!skills) {
  throw new Error('Technical expertise content is missing');
}

const experience = (await getCollection('experience'))
  .sort((left, right) =>
    right.data.start.localeCompare(left.data.start)
  );
---

<BaseLayout title={title}>
  <main>
    <Profile profile={profile} />
    <Highlights highlights={highlights.data.highlights} />
    <Skills skills={skills.data} />

    <section>
      <h2>Experience</h2>

      {
        experience.map((job) => (
          <Experience job={job} />
        ))
      }
    </section>
  </main>
</BaseLayout>
